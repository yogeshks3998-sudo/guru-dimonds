# APP_URL: Optional public URL where this app is hosted.
# Used later for deployment links, callbacks, and generated absolute URLs.
APP_URL="http://localhost:3000"

# Frontend API base URL.
VITE_API_URL="http://localhost:5000/api"

# Backend API configuration.
PORT="5000"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vedaara_fine_jewellery?schema=public"
JWT_SECRET="change-this-before-production"

# Optional payment gateway configuration.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional email provider configuration. Phase 4 logs emails by default.
EMAIL_PROVIDER="log"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="orders@vedaara.com"
