# Application URLs
APP_URL="https://gurudiamonds.in"
VITE_API_URL="https://gurudiamonds.in/api"
PORT="5055"
NODE_ENV="production"

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require"
JWT_SECRET="change-this-to-a-secure-random-secret-before-production"

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID="rzp_test_xxxx"
RAZORPAY_KEY_SECRET="xxxx"
RAZORPAY_WEBHOOK_SECRET=""

# Free Transactional Email Configuration
# Options: "brevo" (300 free emails/day), "resend" (100 free emails/day), or "log" (console fallback)
EMAIL_PROVIDER="brevo"
FROM_EMAIL="info@gurudiamonds.in"
FROM_NAME="Guru Diamonds"

# Brevo API Key (Get free key from: https://app.brevo.com/settings/keys/api)
BREVO_API_KEY=""

# Resend API Key (Get free key from: https://resend.com)
RESEND_API_KEY=""

# Optional Custom SMTP (e.g. Gmail App Password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
