+  const existing = INITIAL_PRODUCTS.filter((p) => !SILVER_COLLECTION_PRODUCTS.some((n) => n.id === p.id));
+  const plan = planSilverImport(existing, SILVER_COLLECTION_PRODUCTS);
+  console.log(JSON.stringify({ mode: 'repository-validation-only; database not inspected or modified', validated: 6, wouldCreate: plan.create.map((p) => p.sku), skipped: plan.skip }, null, 2));
+} else {
+  if (!process.env.DATABASE_URL) throw new Error('DATABASE_URL is required; no database writes attempted.');
+  const { prisma } = await import('../backend/src/config/db');
+  try {
+    if (apply) {
+      const result = await prisma.$transaction((tx: any) => applySilverImport(tx, SILVER_COLLECTION_PRODUCTS), { isolationLevel: 'Serializable', maxWait: 30000, timeout: 30000 });
+      console.log(JSON.stringify({ mode: 'database-apply', ...result }, null, 2));
+    } else {
+      const plan = planSilverImport(await prisma.product.findMany({ include: { variants: true } }), SILVER_COLLECTION_PRODUCTS);
+      console.log(JSON.stringify({ mode: 'database-dry-run; no writes', wouldCreate: plan.create.map((p) => p.sku), skipped: plan.skip }, null, 2));
+    }
+  } finally { await prisma.$disconnect(); }
+}
