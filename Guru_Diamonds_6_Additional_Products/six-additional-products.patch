+const unique = (key: 'id' | 'sku' | 'slug') => new Set(SILVER_COLLECTION_PRODUCTS.map((p) => p[key])).size === 6;
+if (!['id', 'sku', 'slug'].every((key) => unique(key as 'id' | 'sku' | 'slug'))
