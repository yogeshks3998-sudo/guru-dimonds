{
  "name": "guru-diamonds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch backend/src/server.ts",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "vite build",
    "build:server": "esbuild ././backend/src/app.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/app.js",
    "build:api": "esbuild ././backend/src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "build:seo": "tsx scripts/generate-seo.ts",
    "build:prod": "npm run build && npm run build:server && npm run build:seo",
    "preview": "vite preview",
    "api": "tsx backend/src/server.ts",
    "start": "node server.js",
    "start:api": "node dist-server/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:setup:prod": "npm run db:deploy && npm run db:seed && npm run db:seed:brand-identity",
    "db:seed": "tsx backend/src/seed/seed.ts",
    "db:seed:brand-admins": "tsx backend/src/seed/seedBrandAdmins.ts",
    "db:seed:brand-identity": "tsx backend/src/seed/seedBrandIdentity.ts",
    "import:products": "tsx scripts/import-products-from-xlsx.ts",
    "import:products:dry-run": "tsx scripts/import-products-from-xlsx.ts --dry-run",
    "lint": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts --coverage",
    "test:api": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts tests/api tests/integration",
    "test:frontend": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts tests/frontend tests/unit",
    "test:backend": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts tests/backend tests/database",
    "test:auth": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.ts tests/auth",
    "test:vitest": "vitest run --config vitest.config.ts",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-server',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "razorpay": "^2.9.8",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
