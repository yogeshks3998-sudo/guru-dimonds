generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id            String   @id
  name          String
  slug          String   @unique
  description   String
  image         String
  subcategories Json
  featured      Boolean  @default(false)
  itemCount     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JewelleryCollection {
  id          String   @id
  name        String
  slug        String   @unique
  description String
  bannerImage String
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id                  String           @id
  name                String
  slug                String           @unique
  sku                 String           @unique
  shortDescription    String
  description         String
  category            String
  subcategory         String
  collection          String?
  tags                Json
  gender              String
  occasion            Json
  images              Json
  videoUrl            String?
  metalType           String
  metalPurity         String
  metalColor          String
  grossWeightGrams    Float
  netWeightGrams      Float
  gemstones           Json
  hallmarked          Boolean
  hallmarkCenter      String?
  certified           Boolean
  certificationAgency String?
  pricingMode         String
  fixedPrice          Float?
  compareAtPrice      Float?
  makingChargeType    String
  makingChargeValue   Float
  wastagePercentage   Float
  certificationCharge Float
  packagingCharge     Float
  gstPercentage       Float
  totalStock          Int
  hasVariants         Boolean
  variantAttributes   Json
  lowStockThreshold   Int
  readyToShip         Boolean
  dispatchDays        Int
  returnEligible      Boolean
  returnPolicyDays    Int
  codAvailable        Boolean
  badges              Json
  rating              Float
  reviewCount         Int
  status              String
  seoTitle            String?
  seoDescription      String?
  createdAt           DateTime
  updatedAt           DateTime
  variants            ProductVariant[]
  media               ProductMedia[]
  inventoryItems      InventoryItem[]

  @@index([category])
  @@index([status])
  @@index([metalType, metalPurity])
}

model ProductVariant {
  id               String  @id
  productId        String
  sku              String  @unique
  barcode          String
  attributes       Json
  price            Float
  compareAtPrice   Float?
  netWeightGrams   Float
  grossWeightGrams Float
  stock            Int
  images           Json
  enabled          Boolean
  dispatchTimeDays Int
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductMedia {
  id        String  @id @default(cuid())
  productId String
  url       String
  type      String  @default("IMAGE")
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  sku       String
  quantity  Int
  reserved  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model Customer {
  id                String    @id
  name              String
  email             String    @unique
  phone             String
  avatar            String?
  totalOrders       Int       @default(0)
  totalSpent        Float     @default(0)
  averageOrderValue Float     @default(0)
  lastOrderAt       DateTime?
  tags              Json
  marketingConsent  Boolean   @default(false)
  status            String
  createdAt         DateTime
  addresses         Address[]
  orders            Order[]
}

model Address {
  id          String    @id
  customerId  String?
  fullName    String
  phone       String
  email       String
  street      String
  landmark    String?
  city        String
  state       String
  pincode     String
  country     String
  isDefault   Boolean   @default(false)
  addressType String
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model AdminUser {
  id           String    @id
  name         String
  email        String    @unique
  passwordHash String?
  role         String
  avatar       String?
  active       Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Order {
  id                           String               @id
  orderNumber                  String               @unique
  customerId                   String?
  customerSnapshot             Json
  shippingAddress              Json
  billingAddress               Json
  subtotal                     Float
  discountAmount               Float
  couponCode                   String?
  gstTotal                     Float
  shippingCharge               Float
  totalAmount                  Float
  paymentMethod                String
  paymentStatus                String
  orderStatus                  String
  trackingNumber               String?
  courierPartner               String?
  placedAt                     DateTime
  metalRateSnapshotAtPlacement Json
  notes                        String?
  gstInvoiceNumber             String?
  customer                     Customer?            @relation(fields: [customerId], references: [id])
  items                        OrderItem[]
  history                      OrderStatusHistory[]

  @@index([orderStatus])
  @@index([placedAt])
}

model OrderItem {
  id                     String @id
  orderId                String
  productId              String
  variantId              String?
  productName            String
  variantSku             String?
  variantDetails         Json?
  image                  String
  quantity               Int
  unitPrice              Float
  totalPrice             Float
  priceBreakdownSnapshot Json
  customEngraving        String?
  order                  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  timestamp DateTime
  note      String
  updatedBy String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model MetalRate {
  id            String   @id
  metal         String
  purity        String
  ratePerGram   Float
  previousRate  Float
  effectiveDate String
  effectiveTime String
  rateSource    String
  notes         String?
  updatedBy     String
  status        String
  updatedAt     DateTime

  @@index([metal, purity, status])
}

model Coupon {
  id                   String   @id
  code                 String   @unique
  description          String
  discountType         String
  discountValue        Float
  minOrderAmount       Float
  maxDiscountAmount    Float?
  startDate            DateTime
  endDate              DateTime
  usageLimit           Int
  usedCount            Int
  perCustomerLimit     Int
  active               Boolean
  applicableCategories Json?
}

model ProductReview {
  id               String   @id
  productId        String
  productName      String
  customerName     String
  rating           Int
  title            String
  comment          String
  images           Json?
  verifiedPurchase Boolean
  status           String
  createdAt        DateTime
}

model CMSContent {
  id              String   @id @default("default")
  announcementBar Json
  heroBanner      Json
  sections        Json
  footer          Json
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id            String   @id
  timestamp     DateTime
  adminUser     String
  action        String
  module        String
  entityId      String
  details       String
  previousValue String?
  newValue      String?
  ipAddress     String
}
